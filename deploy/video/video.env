# /etc/gcs/video.env - FPV capture settings (read by capture.sh via the gcs-video unit).
# Stable path of the HDMI/DP-to-USB dongle: ls /dev/v4l/by-id/
VIDEO_DEVICE=/dev/video0
VIDEO_SIZE=1280x720
VIDEO_FPS=30
VIDEO_BITRATE=2500k
# device = capture dongle, test = generated test pattern
VIDEO_SOURCE=device
