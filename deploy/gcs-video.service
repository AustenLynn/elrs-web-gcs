[Unit]
Description=GCS video: MediaMTX + FPV capture (kept away from the real-time core)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user: MediaMTX parses network input (SDP/ICE) and must not share a uid with
# crsf-core, whose socket and config belong to gcs.
User=gcs-video
Group=gcs-video
SupplementaryGroups=video
WorkingDirectory=/var/lib/gcs-video
EnvironmentFile=/etc/gcs/video.env
ExecStart=/opt/mediamtx/mediamtx /etc/gcs/mediamtx.yml
Restart=on-failure
RestartSec=2
# Video must never compete with crsf-core: never on CPU 3, lower CPU weight, nicer.
AllowedCPUs=0-2
CPUWeight=50
Nice=10
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
